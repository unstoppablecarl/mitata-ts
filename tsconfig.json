{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "esModuleInterop": false,
    "types": ["bun-types", "deno-types"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
